# Copy to .env and change for anything beyond local development.
POSTGRES_USER=adaptos
POSTGRES_PASSWORD=adaptos
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Used by code running on your machine (training scripts, tests) to reach the Docker stack.
ADAPTOS_MLFLOW_TRACKING_URI=http://localhost:5000
ADAPTOS_DATABASE_URL=postgresql://adaptos:adaptos@localhost:5432/adaptos
ADAPTOS_LOG_LEVEL=INFO
